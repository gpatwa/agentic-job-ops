# Agentic Job Ops — environment variables.
#
# Copy this file to .env and fill in only what you actually want active.
# Anything left blank keeps the deterministic fallback behaviour. Tests
# and CI run without any of these set.
#
# IMPORTANT: OPENAI_API_KEY is a SERVER-SIDE secret. The Vite browser
# bundle deliberately does NOT read this variable, so it can never leak
# into the client. The OpenAI adapter is reachable from Node contexts
# (vitest, scripts, future server / proxy code). The browser app falls
# back to deterministic and the UI shows that mode honestly.

# OpenAI API key. Optional. When set in a Node context, the resume
# intelligence service uses the OpenAI adapter; when unset, it falls
# back to the deterministic adapter.
OPENAI_API_KEY=

# OpenAI model to use for resume intelligence analysis. Defaults to
# gpt-4.1-mini if unset.
OPENAI_RESUME_MODEL=gpt-4.1-mini

# OpenAI model to use for job-related analysis. Defaults to gpt-4.1-mini
# if unset. Reserved for future job-side adapters.
OPENAI_JOB_MODEL=gpt-4.1-mini
