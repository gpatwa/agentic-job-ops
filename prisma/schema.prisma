generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  individual
  career_coach
  university
  bootcamp
  outplacement
  enterprise
}

enum TenantPlan {
  free
  pro
  team
  enterprise
}

enum TenantStatus {
  active
  trialing
  paused
  closed
}

enum RemotePreference {
  remote
  hybrid
  onsite
  any
}

enum ResumeStatus {
  uploaded
  parsed
  failed
}

enum ApplicationStatus {
  discovered
  recommended
  saved
  draft_prepared
  needs_review
  approved
  submitted
  recruiter_contacted
  interviewing
  rejected
  offer
  archived
}

enum JobSource {
  greenhouse
  lever
  crawler
  manual
  api
}

enum AtsType {
  greenhouse
  lever
  manual
  crawler
  api
}

enum JobRemoteType {
  remote
  hybrid
  onsite
  unknown
}

enum ScanSchedule {
  manual
  daily
  every_6_hours
}

enum ScanRunStatus {
  running
  succeeded
  failed
}

enum ScoringStatus {
  queued
  scored
  skipped
}

enum QueueType {
  apply_review
  maybe
  browse
}

enum MatchRecommendation {
  apply
  maybe
  browse
  skip
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  type      TenantType
  plan      TenantPlan
  status    TenantStatus
  createdAt DateTime     @default(now())
}

model UserProfile {
  id                    String           @id @default(cuid())
  tenantId              String
  userId                String
  fullName              String
  email                 String
  phone                 String
  location              String
  workAuthorization     String
  linkedinUrl           String
  portfolioUrl          String
  githubUrl             String
  targetTitles          String[]
  targetLocations       String[]
  targetIndustries      String[]
  remotePreference      RemotePreference
  salaryMin             Int?
  salaryTarget          Int?
  companiesToAvoid      String[]
  companiesToPrioritize String[]
  careerSummary         String
  verifiedFacts         String[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([tenantId, userId])
  @@unique([tenantId, userId])
}

model Resume {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  originalFileName String
  fileUrl          String
  parsedText       String
  status           ResumeStatus
  createdAt        DateTime     @default(now())

  @@index([tenantId, userId])
}

model NormalizedJob {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  sourceConfigId   String?
  source           JobSource
  sourceJobId      String
  title            String
  company          String
  location         String
  remoteType       JobRemoteType
  salaryMin        Int?
  salaryMax        Int?
  description      String
  responsibilities String[]
  requirements     String[]
  applicationUrl   String
  atsType          AtsType
  postedAt         DateTime?
  discoveredAt     DateTime
  scoringStatus    ScoringStatus @default(queued)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
  @@unique([tenantId, source, sourceJobId])
}

model JobSourceConfig {
  id          String       @id @default(cuid())
  tenantId    String
  userId      String
  source      JobSource
  displayName String
  companyName String
  boardToken  String
  siteName    String
  manualUrl   String
  schedule    ScanSchedule
  enabled     Boolean      @default(true)
  lastScanAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, userId])
}

model ScanRun {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String
  sourceConfigId    String
  source            JobSource
  status            ScanRunStatus
  startedAt         DateTime
  finishedAt        DateTime?
  jobsFetched       Int           @default(0)
  jobsInserted      Int           @default(0)
  jobsUpdated       Int           @default(0)
  duplicatesSkipped Int           @default(0)
  errorMessage      String

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
}

model JobMatch {
  id                       String              @id @default(cuid())
  tenantId                 String
  userId                   String
  jobId                    String
  overallScore             Float
  skillsScore              Float
  experienceScore          Float
  seniorityScore           Float
  locationScore            Float
  salaryScore              Float
  industryScore            Float
  companyFitScore          Float
  applicationEffortScore   Float
  strategicValueScore      Float
  recommendation           MatchRecommendation
  queue                    QueueType
  topMatchReasons          String[]
  topGaps                  String[]
  employerLookingFor       String[]
  summary                  String
  recommendedNextAction    String
  scoringVersion           String
  modelName                String
  promptVersion            String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, queue])
  @@unique([tenantId, userId, jobId])
}

model ApplicationRecord {
  id        String            @id @default(cuid())
  tenantId  String
  userId    String
  jobId     String
  status    ApplicationStatus
  notes     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId, userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  action      String
  resourceType String
  resourceId  String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([tenantId, actorUserId])
}
