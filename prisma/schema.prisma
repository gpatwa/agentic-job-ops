generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  individual
  career_coach
  university
  bootcamp
  outplacement
  enterprise
}

enum TenantPlan {
  free
  pro
  team
  enterprise
}

enum TenantStatus {
  active
  trialing
  paused
  closed
}

enum RemotePreference {
  remote
  hybrid
  onsite
  any
}

enum ResumeStatus {
  uploaded
  parsed
  failed
}

enum ApplicationStatus {
  discovered
  recommended
  saved
  draft_prepared
  needs_review
  approved
  submitted
  recruiter_contacted
  interviewing
  rejected
  offer
  withdrawn
  archived
}

enum JobSource {
  greenhouse
  lever
  crawler
  manual
  api
}

enum AtsType {
  greenhouse
  lever
  manual
  crawler
  api
}

enum BrowserAtsType {
  greenhouse
  lever
  ashby
  workday
  linkedin
  custom
  unknown
}

enum JobRemoteType {
  remote
  hybrid
  onsite
  unknown
}

enum ScanSchedule {
  manual
  daily
  every_6_hours
}

enum ScanRunStatus {
  running
  succeeded
  failed
}

enum ScoringStatus {
  queued
  scored
  skipped
}

enum QueueType {
  apply_review
  maybe
  browse
}

enum MatchRecommendation {
  apply
  maybe
  browse
  skip
}

enum ApplicationPackageStatus {
  draft
  ready_for_review
  approved
  rejected
}

enum GenerationMode {
  deterministic
  llm
}

enum AnswerConfidence {
  high
  medium
  low
}

enum ApplicationAnswerSource {
  generated
  user_edited
}

enum BrowserApplicationSessionStatus {
  queued
  opening
  detecting_ats
  detecting_form
  filling
  needs_user_input
  ready_for_review
  approved_for_submit
  submitted
  failed
  manual_required
}

enum FeedbackEventType {
  job_viewed
  job_saved
  job_rejected
  score_overridden
  application_package_generated
  resume_edited
  cover_letter_edited
  application_answer_edited
  application_package_approved
  application_package_rejected
  browser_session_created
  browser_submit_approved
  application_submitted
  manually_applied
  recruiter_response_received
  interview_scheduled
  rejected
  offer_received
}

enum UsageMeteringEventType {
  resume_uploaded
  job_source_created
  scan_run_started
  job_ingested
  job_scored
  application_package_generated
  browser_session_started
  browser_submit_approved
  application_submitted
  llm_tokens_used
}

enum EvalSuite {
  match_score
  application_package
  browser_assistant_safety
}

enum EvalRunSuite {
  all
  match_score
  application_package
  browser_assistant_safety
}

enum EvalRunStatus {
  running
  completed
  failed
}

enum EvalStatus {
  passed
  failed
}

enum ApplicationOutcomeStatus {
  recruiter_response
  interview_scheduled
  rejected
  offer
  withdrawn
  submitted
}

enum AIOutputType {
  match_score
  application_package
  application_answer
  browser_field_mapping
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  type      TenantType
  plan      TenantPlan
  status    TenantStatus
  createdAt DateTime     @default(now())
}

model UserProfile {
  id                    String           @id @default(cuid())
  tenantId              String
  userId                String
  fullName              String
  email                 String
  phone                 String
  location              String
  workAuthorization     String
  linkedinUrl           String
  portfolioUrl          String
  githubUrl             String
  targetTitles          String[]
  targetLocations       String[]
  targetIndustries      String[]
  remotePreference      RemotePreference
  salaryMin             Int?
  salaryTarget          Int?
  companiesToAvoid      String[]
  companiesToPrioritize String[]
  careerSummary         String
  verifiedFacts         String[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([tenantId, userId])
  @@unique([tenantId, userId])
}

model Resume {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  originalFileName String
  fileUrl          String
  parsedText       String
  status           ResumeStatus
  createdAt        DateTime     @default(now())

  @@index([tenantId, userId])
}

model NormalizedJob {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  sourceConfigId   String?
  source           JobSource
  sourceJobId      String
  title            String
  company          String
  location         String
  remoteType       JobRemoteType
  salaryMin        Int?
  salaryMax        Int?
  description      String
  responsibilities String[]
  requirements     String[]
  applicationUrl   String
  atsType          AtsType
  postedAt         DateTime?
  discoveredAt     DateTime
  scoringStatus    ScoringStatus @default(queued)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
  @@unique([tenantId, source, sourceJobId])
}

model JobSourceConfig {
  id          String       @id @default(cuid())
  tenantId    String
  userId      String
  source      JobSource
  displayName String
  companyName String
  boardToken  String
  siteName    String
  manualUrl   String
  schedule    ScanSchedule
  enabled     Boolean      @default(true)
  lastScanAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, userId])
}

model ScanRun {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String
  sourceConfigId    String
  source            JobSource
  status            ScanRunStatus
  startedAt         DateTime
  finishedAt        DateTime?
  jobsFetched       Int           @default(0)
  jobsInserted      Int           @default(0)
  jobsUpdated       Int           @default(0)
  duplicatesSkipped Int           @default(0)
  errorMessage      String

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
}

model JobMatch {
  id                       String              @id @default(cuid())
  tenantId                 String
  userId                   String
  jobId                    String
  overallScore             Float
  skillsScore              Float
  experienceScore          Float
  seniorityScore           Float
  locationScore            Float
  salaryScore              Float
  industryScore            Float
  companyFitScore          Float
  applicationEffortScore   Float
  strategicValueScore      Float
  recommendation           MatchRecommendation
  queue                    QueueType
  topMatchReasons          String[]
  topGaps                  String[]
  employerLookingFor       String[]
  summary                  String
  recommendedNextAction    String
  scoringVersion           String
  modelName                String
  promptVersion            String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, queue])
  @@unique([tenantId, userId, jobId])
}

model ApplicationRecord {
  id        String            @id @default(cuid())
  tenantId  String
  userId    String
  jobId     String
  status    ApplicationStatus
  notes     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId, userId])
}

model ApplicationPackage {
  id                  String                   @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String
  status              ApplicationPackageStatus
  resumeMarkdown      String
  coverLetter         String
  generationMode      GenerationMode
  modelName           String
  promptVersion       String
  inputHash           String
  outputHash          String
  safetyWarnings      String[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  approvedAt          DateTime?
  rejectedAt          DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@unique([tenantId, userId, applicationRecordId])
}

model ApplicationAnswer {
  id                   String                  @id @default(cuid())
  tenantId             String
  userId               String
  applicationPackageId String
  question             String
  answer               String
  confidence           AnswerConfidence
  source               ApplicationAnswerSource
  needsUserReview      Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationPackageId])
}

model BrowserApplicationSession {
  id                   String                          @id @default(cuid())
  tenantId             String
  userId               String
  jobId                String
  applicationRecordId  String
  applicationPackageId String
  atsType              BrowserAtsType
  status               BrowserApplicationSessionStatus
  fieldsDetected       Json
  fieldsFilled         Json
  uncertainFields      Json
  screenshotUrl        String?
  errorMessage         String
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationPackageId])
  @@index([tenantId, applicationRecordId])
}

model FeedbackEvent {
  id           String            @id @default(cuid())
  tenantId     String
  userId       String
  eventType    FeedbackEventType
  resourceType String
  resourceId   String
  metadata     Json
  createdAt    DateTime          @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, eventType])
}

model EvalCase {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  suite            EvalSuite
  name             String
  description      String
  inputSummary     String
  expectedBehavior String
  createdAt        DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, suite])
}

model EvalRun {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String
  suite      EvalRunSuite
  status     EvalRunStatus
  startedAt  DateTime
  finishedAt DateTime?
  passCount  Int           @default(0)
  failCount  Int           @default(0)

  @@index([tenantId, userId])
  @@index([tenantId, suite])
}

model EvalResult {
  id         String     @id @default(cuid())
  tenantId   String
  userId     String
  evalRunId  String
  evalCaseId String
  suite      EvalSuite
  name       String
  status     EvalStatus
  message    String
  severity   String
  createdAt  DateTime   @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, evalRunId])
}

model UsageMeteringEvent {
  id           String                 @id @default(cuid())
  tenantId     String
  userId       String
  eventType    UsageMeteringEventType
  resourceType String
  resourceId   String
  quantity     Float
  unit         String
  metadata     Json
  createdAt    DateTime               @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, eventType])
}

model ApplicationOutcome {
  id                  String                   @id @default(cuid())
  tenantId            String
  userId              String
  applicationRecordId String
  jobId               String
  outcome             ApplicationOutcomeStatus
  outcomeDate         DateTime
  notes               String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationRecordId])
}

model AIOutputMetadata {
  id            String       @id @default(cuid())
  tenantId      String
  userId        String
  outputType    AIOutputType
  resourceType  String
  resourceId    String
  modelName     String
  promptVersion String
  provider      String
  mode          String
  inputHash     String
  outputHash    String
  tokenInput    Int          @default(0)
  tokenOutput   Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, outputType])
  @@index([tenantId, resourceType, resourceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  action      String
  resourceType String
  resourceId  String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([tenantId, actorUserId])
}
