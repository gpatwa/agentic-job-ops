model Tenant {
  id        String       @id @default(cuid())
  name      String
  type      TenantType
  plan      TenantPlan
  status    TenantStatus
  createdAt DateTime     @default(now())
}

model UserProfile {
  id                    String           @id @default(cuid())
  tenantId              String
  userId                String
  fullName              String
  email                 String
  phone                 String
  location              String
  workAuthorization     String
  linkedinUrl           String
  portfolioUrl          String
  githubUrl             String
  targetTitles          String[]
  targetLocations       String[]
  targetIndustries      String[]
  remotePreference      RemotePreference
  salaryMin             Int?
  salaryTarget          Int?
  companiesToAvoid      String[]
  companiesToPrioritize String[]
  careerSummary         String
  verifiedFacts         String[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([tenantId, userId])
  @@unique([tenantId, userId])
}

model Resume {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  originalFileName String
  fileUrl          String
  parsedText       String
  status           ResumeStatus
  createdAt        DateTime     @default(now())

  @@index([tenantId, userId])
}

model NormalizedJob {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  sourceConfigId   String?
  source           JobSource
  sourceJobId      String
  title            String
  company          String
  location         String
  remoteType       JobRemoteType
  salaryMin        Int?
  salaryMax        Int?
  description      String
  responsibilities String[]
  requirements     String[]
  applicationUrl   String
  atsType          AtsType
  postedAt         DateTime?
  discoveredAt     DateTime
  scoringStatus    ScoringStatus @default(queued)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
  @@unique([tenantId, source, sourceJobId])
}

model JobSourceConfig {
  id          String       @id @default(cuid())
  tenantId    String
  userId      String
  source      JobSource
  displayName String
  companyName String
  boardToken  String
  siteName    String
  manualUrl   String
  schedule    ScanSchedule
  enabled     Boolean      @default(true)
  lastScanAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, userId])
}

model ScanRun {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String
  sourceConfigId    String
  source            JobSource
  status            ScanRunStatus
  startedAt         DateTime
  finishedAt        DateTime?
  jobsFetched       Int           @default(0)
  jobsInserted      Int           @default(0)
  jobsUpdated       Int           @default(0)
  duplicatesSkipped Int           @default(0)
  errorMessage      String

  @@index([tenantId, userId])
  @@index([tenantId, sourceConfigId])
}

model JobMatch {
  id                       String              @id @default(cuid())
  tenantId                 String
  userId                   String
  jobId                    String
  overallScore             Float
  skillsScore              Float
  experienceScore          Float
  seniorityScore           Float
  locationScore            Float
  salaryScore              Float
  industryScore            Float
  companyFitScore          Float
  applicationEffortScore   Float
  strategicValueScore      Float
  recommendation           MatchRecommendation
  queue                    QueueType
  topMatchReasons          String[]
  topGaps                  String[]
  employerLookingFor       String[]
  summary                  String
  recommendedNextAction    String
  scoringVersion           String
  modelName                String
  promptVersion            String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, queue])
  @@unique([tenantId, userId, jobId])
}

model ApplicationRecord {
  id        String            @id @default(cuid())
  tenantId  String
  userId    String
  jobId     String
  status    ApplicationStatus
  notes     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId, userId])
}

model ApplicationPackage {
  id                  String                   @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String
  status              ApplicationPackageStatus
  resumeMarkdown      String
  coverLetter         String
  generationMode      GenerationMode
  modelName           String
  promptVersion       String
  inputHash           String
  outputHash          String
  safetyWarnings      String[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  approvedAt          DateTime?
  rejectedAt          DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@unique([tenantId, userId, applicationRecordId])
}

model ApplicationAnswer {
  id                   String                  @id @default(cuid())
  tenantId             String
  userId               String
  applicationPackageId String
  question             String
  answer               String
  confidence           AnswerConfidence
  source               ApplicationAnswerSource
  needsUserReview      Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationPackageId])
}

model BrowserApplicationSession {
  id                   String                          @id @default(cuid())
  tenantId             String
  userId               String
  jobId                String
  applicationRecordId  String
  applicationPackageId String
  atsType              BrowserAtsType
  adapterName          String                          @default("unknown")
  adapterConfidence    Float                           @default(0)
  fillMode             BrowserFillMode                 @default(dry_run)
  status               BrowserApplicationSessionStatus
  fieldsDetected       Json
  fieldsFilled         Json
  uncertainFields      Json
  fillPlan             Json
  screenshotUrl        String?
  errorMessage         String
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationPackageId])
  @@index([tenantId, applicationRecordId])
}

model FeedbackEvent {
  id           String            @id @default(cuid())
  tenantId     String
  userId       String
  eventType    FeedbackEventType
  resourceType String
  resourceId   String
  metadata     Json
  createdAt    DateTime          @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, eventType])
}

model EvalCase {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  suite            EvalSuite
  name             String
  description      String
  inputSummary     String
  expectedBehavior String
  createdAt        DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, suite])
}

model EvalRun {
  id         String        @id @default(cuid())
  tenantId   String
  userId     String
  suite      EvalRunSuite
  status     EvalRunStatus
  startedAt  DateTime
  finishedAt DateTime?
  passCount  Int           @default(0)
  failCount  Int           @default(0)

  @@index([tenantId, userId])
  @@index([tenantId, suite])
}

model EvalResult {
  id         String     @id @default(cuid())
  tenantId   String
  userId     String
  evalRunId  String
  evalCaseId String
  suite      EvalSuite
  name       String
  status     EvalStatus
  message    String
  severity   String
  createdAt  DateTime   @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, evalRunId])
}

model UsageMeteringEvent {
  id           String                 @id @default(cuid())
  tenantId     String
  userId       String
  eventType    UsageMeteringEventType
  resourceType String
  resourceId   String
  quantity     Float
  unit         String
  metadata     Json
  createdAt    DateTime               @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, eventType])
}

model ApplicationOutcome {
  id                  String                   @id @default(cuid())
  tenantId            String
  userId              String
  applicationRecordId String
  jobId               String
  outcome             ApplicationOutcomeStatus
  outcomeDate         DateTime
  notes               String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, applicationRecordId])
}

model AIOutputMetadata {
  id            String       @id @default(cuid())
  tenantId      String
  userId        String
  outputType    AIOutputType
  resourceType  String
  resourceId    String
  modelName     String
  promptVersion String
  provider      String
  mode          String
  inputHash     String
  outputHash    String
  tokenInput    Int          @default(0)
  tokenOutput   Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, outputType])
  @@index([tenantId, resourceType, resourceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  action      String
  resourceType String
  resourceId  String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([tenantId, actorUserId])
}

model RealSiteDryRunSnapshot {
  id                   String         @id @default(cuid())
  tenantId             String
  userId               String
  sourceUrl            String
  redactedUrl          String
  hostname             String
  atsType              BrowserAtsType
  adapterConfidence    Float
  pageTitle            String         @default("")
  detectedFieldCount   Int
  requiredFieldCount   Int
  safeFillCount        Int
  pausedFieldCount     Int
  sensitiveFieldCount  Int
  submitButtonCount    Int
  submitBlocked        Boolean        @default(true)
  submitBlockedReason  String
  validationSummary    Json
  source               String
  extensionSessionId   String?
  createdAt            DateTime       @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, hostname])
}

model CareerOpsSettings {
  id                              String                @id @default(cuid())
  tenantId                        String
  userId                          String
  scheduleMode                    CareerOpsScheduleMode
  preparePackagesForHighScoreJobs Boolean               @default(false)
  highScoreThreshold              Float                 @default(8.0)
  overrideHighRiskPackagePrep     Boolean               @default(false)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  @@unique([tenantId, userId])
}

model CompanyIntelligence {
  id                  String                  @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  company             String
  summary             String
  businessModel       String                  @default("")
  industry            String                  @default("")
  companySize         String                  @default("")
  fundingStage        String                  @default("")
  recentSignals       Json
  whyThisCompany      String                  @default("")
  interviewPrepNotes  Json
  compensationSignals String                  @default("")
  referralStrategy    String                  @default("")
  source              IntelligenceSource
  confidence          IntelligenceConfidence
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([tenantId, userId, jobId])
  @@index([tenantId, userId])
}

model RecruiterLead {
  id                 String                 @id @default(cuid())
  tenantId           String
  userId             String
  jobId              String
  company            String
  name               String
  title              String                 @default("")
  publicProfileUrl   String                 @default("")
  source             IntelligenceSource
  confidence         IntelligenceConfidence
  outreachSuggestion String                 @default("")
  createdAt          DateTime               @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
}

model RecruiterContact {
  id                  String                     @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String?
  company             String
  name                String                     @default("")
  title               String                     @default("")
  email               String                     @default("")
  publicProfileUrl    String                     @default("")
  source              RecruiterContactSource
  confidence          RecruiterContactConfidence
  notes               String                     @default("")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, applicationRecordId])
}

model OutreachDraft {
  id                  String              @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String?
  recruiterContactId  String?
  type                OutreachDraftType
  subject             String              @default("")
  body                String              @default("")
  status              OutreachDraftStatus
  generationMode      GenerationMode
  modelName           String
  promptVersion       String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  approvedAt          DateTime?
  sentManuallyAt      DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, applicationRecordId])
  @@index([tenantId, recruiterContactId])
}

model FollowUpReminder {
  id                  String                 @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String?
  recruiterContactId  String?
  dueAt               DateTime
  reason              String
  status              FollowUpReminderStatus
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, jobId])
  @@index([tenantId, applicationRecordId])
}

model InterviewNote {
  id                  String         @id @default(cuid())
  tenantId            String
  userId              String
  jobId               String
  applicationRecordId String?
  stage               InterviewStage
  scheduledAt         DateTime?
  interviewerNames    Json
  notes               String         @default("")
  questionsAsked      Json
  followUps           Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, applicationRecordId])
}

model ResumeImprovementDraft {
  id                  String                  @id @default(cuid())
  tenantId            String
  userId              String
  sourceResumeId      String
  improvedResumeId    String?
  reportId            String
  status              ResumeImprovementStatus
  generationMode      ResumeIntelligenceMode
  modelName           String
  promptVersion       String
  originalRiskLevel   AtsRiskLevel
  improvedRiskLevel   AtsRiskLevel?
  originalRiskScore   Float
  improvedRiskScore   Float?
  draftMarkdown       String
  changesSummary      Json
  appliedFixes        Json
  warningsRemaining   Json
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  savedAt             DateTime?
  rejectedAt          DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, sourceResumeId])
}

model ResumeIntelligenceReport {
  id                 String                 @id @default(cuid())
  tenantId           String
  userId             String
  resumeId           String
  extractionMode     ResumeIntelligenceMode
  modelName          String
  promptVersion      String
  extractedProfile   Json
  confidenceByField  Json
  missingFields      Json
  ambiguousFields    Json
  parsingWarnings    Json
  atsRiskScore       Float
  atsRiskLevel       AtsRiskLevel
  suggestedFixes     Json
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([tenantId, userId, resumeId])
  @@index([tenantId, userId])
}

model JobTargetRecommendation {
  id                          String                 @id @default(cuid())
  tenantId                    String
  userId                      String
  resumeId                    String
  reportId                    String
  strongestRoles              Json
  adjacentRoles               Json
  stretchRoles                Json
  rolesToAvoid                Json
  recommendedIndustries       Json
  recommendedSeniority        String                 @default("")
  recommendedSearchKeywords   Json
  positioningSummary          String                 @default("")
  resumePositioningAdvice     Json
  skillGaps                   Json
  confidence                  ResumeFieldConfidence
  extractionMode              ResumeIntelligenceMode
  modelName                   String
  promptVersion               String
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@unique([tenantId, userId, resumeId])
  @@index([tenantId, userId])
}

model OnboardingState {
  id                       String    @id @default(cuid())
  tenantId                 String
  userId                   String
  selectedTargetRoles      Json
  onboardingJobsGenerated  Boolean   @default(false)
  onboardingJobsScored     Boolean   @default(false)
  firstApplyReadyJobsShown Boolean   @default(false)
  firstJobReviewed         Boolean   @default(false)
  onboardingCompletedAt    DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([tenantId, userId])
}

model JobRiskSignal {
  id                String            @id @default(cuid())
  tenantId          String
  userId            String
  jobId             String
  riskType          JobRiskSignalType
  severity          JobRiskSeverity
  explanation       String
  recommendedAction String            @default("")
  createdAt         DateTime          @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, severity])
}

model CareerOpsRun {
  id                String             @id @default(cuid())
  tenantId          String
  userId            String
  mode              CareerOpsRunMode
  status            CareerOpsRunStatus
  startedAt         DateTime
  completedAt       DateTime?
  ingestionRunIds   Json
  jobsFound         Int                @default(0)
  jobsInserted      Int                @default(0)
  jobsUpdated       Int                @default(0)
  duplicatesFound   Int                @default(0)
  jobsScored        Int                @default(0)
  applyReviewCount  Int                @default(0)
  maybeCount        Int                @default(0)
  browseCount       Int                @default(0)
  packagesPrepared  Int                @default(0)
  digestSummary     Json
  errorMessage      String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model ExtensionSession {
  id                          String                 @id @default(cuid())
  tenantId                    String
  userId                      String
  extensionInstanceId         String
  pageUrl                     String
  pageTitle                   String
  hostname                    String
  status                      ExtensionSessionStatus
  applicationPackageId        String?
  applicationRecordId         String?
  jobId                       String?
  browserApplicationSessionId String?
  fieldsDetected              Json
  fieldsFilled                Json
  uncertainFields             Json
  fillPlan                    Json
  pageStructureHash           String
  authorizedAt                DateTime?
  fillApprovedAt              DateTime?
  submitApprovedAt            DateTime?
  submittedAt                 DateTime?
  disconnectedAt              DateTime?
  errorMessage                String                 @default("")
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, browserApplicationSessionId])
}

model AutopilotSettings {
  id                                   String                     @id @default(cuid())
  tenantId                             String
  userId                               String
  enabled                              Boolean                    @default(false)
  runFrequency                         AutopilotRunFrequency      @default(manual)
  autoScoreJobs                        Boolean                    @default(true)
  autoPreparePackagesForHighScoreJobs  Boolean                    @default(false)
  highScoreThreshold                   Float                      @default(8.0)
  maxPackagesPerRun                    Int                        @default(3)
  requireReviewBeforePackageGeneration Boolean                    @default(false)
  // Hard safety invariant. Always true. The application service rejects
  // any attempt to set this to false.
  requireApprovalBeforeSubmit          Boolean                    @default(true)
  excludedCompanies                    Json
  preferredWorkStyle                   AutopilotPreferredWorkStyle @default(any)
  targetRoles                          Json
  createdAt                            DateTime                   @default(now())
  updatedAt                            DateTime                   @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
}

model AutopilotRun {
  id              String              @id @default(cuid())
  tenantId        String
  userId          String
  triggeredBy     AutopilotRunTrigger
  status          AutopilotRunStatus
  startedAt       DateTime
  finishedAt      DateTime?
  careerOpsRunId  String?
  jobsScored      Int                 @default(0)
  highScoreJobs   Int                 @default(0)
  packagesPrepared Int                @default(0)
  actionsCreated  Int                 @default(0)
  blockedReasons  Json
  errorMessage    String              @default("")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, careerOpsRunId])
}

model AutopilotAction {
  id                   String                  @id @default(cuid())
  tenantId             String
  userId               String
  type                 AutopilotActionType
  title                String
  reason               String
  urgency              AutopilotActionUrgency
  jobId                String?
  applicationRecordId  String?
  applicationPackageId String?
  primaryCtaLabel      String
  primaryCtaRoute      String
  secondaryCtaLabel    String                  @default("")
  secondaryCtaRoute    String                  @default("")
  status               AutopilotActionStatus   @default(pending)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  completedAt          DateTime?
  dismissedAt          DateTime?
  snoozedUntil         DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, status, urgency])
  @@index([tenantId, type])
  @@index([tenantId, applicationRecordId])
  @@index([tenantId, jobId])
}
